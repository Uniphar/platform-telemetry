<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Uniphar.Platform.Telemetry.Testing</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <Version>2.0</Version>
    <Authors>Uniphar</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>Uniphar.Platform.Telemetry.Testing</Title>
    <Description>Test helpers to assert on telemetry (spans, logs) that reached Dash0 from integration tests.</Description>
    <PackageProjectUrl>https://github.com/Uniphar/platform-telemetry</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Uniphar/platform-telemetry</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>telemetry;testing;dash0;uniphar;dotnet;opentelemetry</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
